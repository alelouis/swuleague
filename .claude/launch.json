{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "swuleague",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "flask",
        "--app",
        "app",
        "run",
        "--debug",
        "--port",
        "5000"
      ],
      "port": 5000
    },
    {
      "name": "swuleague-worker",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8787",
        "--cwd",
        "worker"
      ],
      "port": 8787
    }
  ]
}